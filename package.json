{
  "name": "greenwood-guardian-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "npm run typecheck",
    "test": "npm run logic:check && npm run locale:check",
    "typecheck": "tsc --noEmit",
    "data:check": "node scripts/check-data.js",
    "config:apply": "node scripts/apply-school-config.js",
    "verify": "npm run data:check && npm run route:check && npm run syntax:check && npm run style:check && npm run logic:check && npm run locale:check && npm run typecheck",
    "route:check": "node scripts/check-routes.js",
    "syntax:check": "node scripts/check-source-syntax.js",
    "style:check": "node scripts/check-inline-styles.js",
    "logic:check": "node scripts/check-logic.js",
    "locale:check": "node scripts/check-localization.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.19",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "i18next": "^26.5.11",
    "react": "19.3.0",
    "react-i18next": "^17.1.9",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "typescript": "~6.0.3"
  }
}
