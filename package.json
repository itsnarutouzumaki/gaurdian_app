{
  "name": "greenwood-guardian-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build": "npm run typecheck",
    "test": "npm run logic:check && npm run locale:check",
    "typecheck": "tsc --noEmit",
    "data:check": "node scripts/check-data.js",
    "config:apply": "node scripts/apply-school-config.js",
    "verify": "npm run data:check && npm run route:check && npm run syntax:check && npm run style:check && npm run logic:check && npm run locale:check && npm run typecheck",
    "route:check": "node scripts/check-routes.js",
    "syntax:check": "node scripts/check-source-syntax.js",
    "style:check": "node scripts/check-inline-styles.js",
    "logic:check": "node scripts/check-logic.js",
    "locale:check": "node scripts/check-localization.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-documents/picker": "^12.0.3",
    "i18next": "^26.5.11",
    "react": "19.2.3",
    "react-i18next": "^17.1.9",
    "react-native": "0.86.0",
    "react-native-fs": "^2.20.0",
    "react-native-image-crop-picker": "^0.52.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-share": "^12.3.1"
  },
  "devDependencies": {
    "@react-native/codegen": "0.86.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.3",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
