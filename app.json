{
  "expo": {
    "name": "Greenwood International School",
    "slug": "greenwood-international-school",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "greenwood-international-school",
    "backgroundColor": "#F4F7FC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.greenwoodinternational.guardian"
    },
    "android": {
      "package": "com.greenwoodinternational.guardian",
      "adaptiveIcon": {
        "backgroundColor": "#073C88",
        "foregroundImage": "./assets/greenwood-guardian-adaptive.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-image-picker",
      "expo-document-picker",
      "expo-notifications",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/mnnit-logo-white.png",
            "imageWidth": 240,
            "resizeMode": "contain",
            "backgroundColor": "#073C88"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0c18a893-cad7-4e72-a4cb-4bb4587ecf87"
      }
    },
    "icon": "./assets/greenwood-guardian-icon.png"
  }
}
